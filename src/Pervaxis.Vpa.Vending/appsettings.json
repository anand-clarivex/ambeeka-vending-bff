{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http": "Warning"
      }
    },
    "CloudWatch": {
      "LogGroup": "/pervaxis/vending/vending-service",
      "LogStreamPrefix": "vending-service"
    }
  },

  "Resilience": {
    "Default": {
      "MaxRetryAttempts": 3,
      "CircuitBreakerFailureThreshold": 5,
      "CircuitBreakerSamplingWindowSeconds": 30,
      "CircuitBreakerBreakDurationSeconds": 60,
      "TimeoutSeconds": 30
    },
    "External": {
      "MaxRetryAttempts": 2,
      "CircuitBreakerFailureThreshold": 3,
      "CircuitBreakerSamplingWindowSeconds": 60,
      "CircuitBreakerBreakDurationSeconds": 120,
      "TimeoutSeconds": 15
    }
  },
  "ExternalServices": {
    "BaseUrl": ""
  },

  "OpenTelemetry": {
    "OtlpEndpoint": "http://localhost:4317"
  },

  "Forge": {
    "ServiceName": "vending-service",
    "EnableSwagger": false,
    "Oidc": {
      "Provider": "Cognito",
      "Authority": "",
      "Audience": "",
      "Domain": ""
    },
    "Authentication": {
      "ApiKey": "",
      "Scheme": "Bearer"
    },
    "Authorization": {
      "AdminGroup": "Admin"
    },
    "Secrets": {
      "UseSecretsManager": false,
      "SecretId": "",
      "ApiKeySecretKey": "Forge:Authentication:ApiKey"
    },
    "AuditLogging": {
      "Enabled": true
    },
    "DataClassification": {
      "DefaultClassification": "internal",
      "SensitiveKeys": ["password", "secret", "token", "apiKey", "email", "phone"]
    },
    "OutputCaching": {
      "Enabled": false,
      "DefaultExpirationSeconds": 60
    },
    "Cors": {
      "AllowedOrigins": ["http://localhost:4209"]
    }
  }
}
